# Copy to apps/server/.env and adjust if you changed the compose defaults.
# Never commit the real .env — it is gitignored.

# --- Database -------------------------------------------------------------
# Must match the POSTGRES_* values in infra/docker-compose.yml.
POSTGRES_USER=collab
POSTGRES_PASSWORD=collab_dev_password
POSTGRES_DB=collab_editor
POSTGRES_PORT=5432

DATABASE_URL="postgresql://collab:collab_dev_password@localhost:5432/collab_editor?schema=public"

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Validated at boot (min 16 chars) since module 1.1b; used to sign sessions from
# module 1.2. Replace before anything leaves this machine.
JWT_SECRET="dev_only_change_me"

# The one browser origin allowed to make mutating requests. In dev the Vite
# server proxies /api here, so requests arrive same-origin.
WEB_ORIGIN="http://localhost:5173"
