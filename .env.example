# Copy to apps/server/.env and adjust if you changed the compose defaults.
# Never commit the real .env — it is gitignored.

# --- Database -------------------------------------------------------------
# Must match the POSTGRES_* values in infra/docker-compose.yml.
POSTGRES_USER=collab
POSTGRES_PASSWORD=collab_dev_password
POSTGRES_DB=collab_editor
POSTGRES_PORT=5432

DATABASE_URL="postgresql://collab:collab_dev_password@localhost:5432/collab_editor?schema=public"

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# The runner (apps/runner) reads REDIS_URL from its own environment, or from
# apps/runner/.env. Its built-in default is redis://localhost:6379, which
# matches the compose defaults above — so it needs no .env at all.
# If you change REDIS_PORT, export REDIS_URL for the runner too, or it will
# keep talking to 6379 while the server moves.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Validated at boot (min 16 chars) since module 1.1b; used to sign sessions from
# module 1.2. Replace before anything leaves this machine.
JWT_SECRET="dev_only_change_me"

# The one browser origin allowed to make mutating requests. In dev the Vite
# server proxies /api here, so requests arrive same-origin.
WEB_ORIGIN="http://localhost:5173"

# --- A second instance (module 7.2) ---------------------------------------
# Collaboration is multi-instance from Phase 7: two servers sharing one Redis
# and one Postgres fan out document updates to each other over the doc bus.
#
#   npm run dev:server     +  npm run dev:web      -> :4000 / :5173
#   npm run dev:server:b   +  npm run dev:web:b    -> :4001 / :5174
#   npm run dev:runner                             -> one runner serves both
#
# Three settings must line up for the second stack, and the scripts above set
# all three:
#
#   PORT=4001                          the server's own port
#   WEB_ORIGIN=http://localhost:5174   or every mutating request from the second
#                                      browser gets 403 BAD_ORIGIN. This is the
#                                      one that is easy to forget, and it fails
#                                      only half visibly: originCheck guards
#                                      mutating methods, so reads still work.
#   API_PORT=4001                      read by apps/web/vite.config.ts, or the
#                                      second browser silently proxies to the
#                                      FIRST server and proves nothing.
#
# DOC_BUS_ENABLED (server, optional) defaults to on outside tests. Set it to
# false only to run a single instance with no Redis fan-out at all.
#
# Run output does NOT cross instances: a browser must reach the instance that
# accepted its POST /run. See docs/notes/scaling.md.
